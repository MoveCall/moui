            bool "Extra widgets (Dots, Number, Stepper, Sparkline, Checklist)"
            default n

        config MOUI_USE_MISC
            bool "Misc widgets (Marquee, Badge, Divider, Loading)"
            default n
    endmenu

    menu "Features"
        config MOUI_USE_QRCODE
            bool "QR code generator"
            default n
            help
                Adds ~2KB Flash. Enable if you need to display QR codes.

        config MOUI_USE_DITHER
            bool "Dither fill patterns"
            default y

        config MOUI_USE_PATTERN
            bool "Texture patterns"
            default y

        config MOUI_USE_ICONS
            bool "Built-in icon set"
            default y

        config MOUI_USE_I18N
            bool "Internationalization (i18n)"
