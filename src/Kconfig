        config MOUI_USE_GRID
            bool "Grid layout"
            default y

        config MOUI_USE_POPUP
            bool "Popup / dialog"
            default y

        config MOUI_USE_ANIM
            bool "Animation engine"
            default y
    endmenu

    menu "Drivers"
        config MOUI_USE_DRV_SSD1306
