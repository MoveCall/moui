    menu "Tuning"
        config MOUI_SCREEN_MAX_WIDGETS
            int "Max widgets per screen"
            default 16
            range 4 64

        config MOUI_SCREEN_STACK_SIZE
            int "Screen stack depth"
            default 8
            range 2 32

        config MOUI_ANIM_POOL_SIZE
            int "Animation pool size"
            default 16
            range 4 64

        config MOUI_INPUT_QUEUE_SIZE
            int "Input event queue size"
            default 8
            range 4 32

        config MOUI_EVT_MAX_HANDLERS
            int "Event bus max handlers"
            default 16
            range 4 64

        config MOUI_CLIP_STACK_DEPTH
            int "Clip stack depth"
            default 8
            range 4 16

        config MOUI_CONTAINER_MAX_CHILDREN
            int "Layout container max children"
            default 16
            range 4 64

        config MOUI_QR_MAX_VERSION
            int "QR code max version"
            default 6
            range 1 10
            depends on MOUI_USE_QRCODE

        config MOUI_DEBUG_BOUNDS
            bool "Draw debug bounding boxes"
            default n

        config MOUI_LOG_ENABLE
            bool "Enable logging"
            default y
    endmenu

